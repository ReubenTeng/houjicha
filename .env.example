APP_MODE=sandbox
MCP_READ_ONLY=true
MCP_DATABASE_BACKEND=supabase
MCP_DATABASE_SCHEMA=houjicha_mcp
PUBLIC_BASE_URL=http://127.0.0.1:3000
BIND_HOST=127.0.0.1
PORT=3000
TRUST_PROXY_HOPS=0
DATABASE_URL=
POSTGRES_PASSWORD=<local-password>
# setup:mcp-sandbox stores a generated DATA_ENCRYPTION_KEY in .reap/mcp.env.
# Set DATA_ENCRYPTION_KEY in the deployment secret store for hosted deployments.
ALLOWED_COUNTRIES=SG
ALLOWED_CURRENCIES=USD
ALLOWED_MERCHANTS={"death-wish-coffee":"Death Wish Coffee"}
PURCHASE_CAPS={"USD":"100.00"}
CATALOG_URL_HOSTS=
REAP_BASE_URL=https://sg.sandbox.api.reap.global
REAP_API_KEY=
REAP_API_VERSION=2025-02-14
REAP_PROJECT_REFERENCE=houjicha-catalog
REAP_HOSTED_URL_HOSTS=
REAP_MONEY_UNIT=major
REAP_CHECKOUT_ENABLED=false
REAP_PER_PURCHASE_APPROVAL_CONFIRMED=false
REAP_APPROVAL_VERIFICATION_REF=
REAP_RETURN_URL_CONFIRMED=false
SANDBOX_SIMULATE_CHECKOUT=false
OAUTH_ISSUER=
OAUTH_AUDIENCE=
OAUTH_JWKS_URI=
OAUTH_METADATA_URL=
OAUTH_SCOPES_CLAIM=scope
OAUTH_EMAIL_CLAIM=email
OAUTH_EMAIL_VERIFIED_CLAIM=email_verified
ALLOWED_SUBJECTS=
ALLOWED_ORIGINS=
LOCAL_DEMO_SUBJECT=demo
LOCAL_DEMO_EMAIL=demo@example.invalid
LOCAL_DEMO_EMAIL_VERIFIED=false
UPSTREAM_TIMEOUT_MS=20000
STATUS_TIMEOUT_MS=5000
PII_RETENTION_HOURS=72
AUDIT_RETENTION_DAYS=30
RECOVERY_INTERVAL_MS=10000
MOCK_SCENARIO=success
GROUP_BUY_ENABLED=true
GROUP_BUY_COUNTRY=SG
GROUP_BUY_CURRENCY=USD
TELEGRAM_BOT_TOKEN=

# Backend-only PostgreSQL fields from Supabase's Connect -> Session pooler.
# Copy the exact Host, Port and User values from that dialog.
# SUPABASE_URL is the pooler hostname ending in .pooler.supabase.com,
# not a PostgreSQL connection string or the https:// project API URL.
SUPABASE_URL=
SUPABASE_PORT=5432
SUPABASE_USER=
SUPABASE_PASSWORD=
SUPABASE_DATABASE=postgres

# Download Supabase's official database CA from the repository root:
# curl --fail --location https://supabase-downloads.s3.amazonaws.com/prod/ssl/prod-ca-2021.crt -o .env.supabase-ca.crt
# This public CA file stays local and is ignored by Git.
# TLS certificate verification is always enabled. Do not disable it.
SUPABASE_SSL_CA_FILE=

# Supabase-backed, read-only MCP catalogue profile (setup:mcp-sandbox writes
# these defaults plus a private encryption key to ignored .reap/mcp.env).
# Exported settings and .env take precedence over that local profile.
# MCP_DATABASE_BACKEND=supabase
# MCP_DATABASE_SCHEMA=houjicha_mcp
# MCP_READ_ONLY=true
# APP_MODE=sandbox
# GROUP_BUY_ENABLED=true
# GROUP_BUY_COUNTRY=SG
# GROUP_BUY_CURRENCY=USD
# GROUP_BUY_REAP_DATA_DIR=/absolute/persistent/path/to/reap-group-state
