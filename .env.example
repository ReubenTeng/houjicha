TELEGRAM_BOT_TOKEN=
REAP_API_KEY=

# Backend-only PostgreSQL fields from Supabase's Connect dialog.
# Use the database host or pooler host, not the https:// project API URL.
# Session pooling is recommended. Copy its exact host, port and username.
SUPABASE_URL=
SUPABASE_PORT=5432
SUPABASE_USER=
SUPABASE_PASSWORD=
SUPABASE_DATABASE=postgres

# Optional path to Supabase's downloaded database CA certificate (PEM).
# TLS certificate verification is always enabled. Do not disable it.
SUPABASE_SSL_CA_FILE=
