{
  "name": "houjicha",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23 || >=24 <25"
  },
  "scripts": {
    "dev": "tsx src/reap/http-main.ts",
    "dev:stdio": "tsx src/reap/stdio-main.ts",
    "dev:telegram": "tsx src/telegram/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/reap/http-main.js",
    "start:stdio": "node dist/reap/stdio-main.js",
    "start:telegram": "node dist/telegram/index.js",
    "setup:local": "tsx scripts/setup-local.ts",
    "db:migrate": "tsx src/reap/migrate.ts",
    "db:setup:group": "tsx scripts/setup-group-buy.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "docs:generate": "tsx scripts/build-api-docs.ts",
    "docs:check": "tsc -p tsconfig.docs.json && tsx scripts/build-api-docs.ts --check",
    "docs:serve": "tsx scripts/serve-docs.ts",
    "orchestration:demo": "tsx src/orchestration/demo-cli.ts",
    "db:setup": "node --env-file-if-exists=.env --import tsx scripts/setup-supabase.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.2.0",
    "decimal.js": "10.6.0",
    "express": "5.2.1",
    "grammy": "^1.35.0",
    "jose": "6.1.3",
    "lossless-json": "4.3.1",
    "pg": "^8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@types/express": "5.0.3",
    "@types/node": "^22.16.0",
    "@types/pg": "^8.23.1",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
