{
  "name": "houjicha",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx src/telegram/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/telegram/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "docs:generate": "tsx scripts/build-api-docs.ts",
    "docs:check": "tsc -p tsconfig.docs.json && tsx scripts/build-api-docs.ts --check",
    "docs:serve": "tsx scripts/serve-docs.ts",
    "orchestration:demo": "tsx src/orchestration/demo-cli.ts"
  },
  "dependencies": {
    "grammy": "^1.35.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "@types/pg": "^8.23.1",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
