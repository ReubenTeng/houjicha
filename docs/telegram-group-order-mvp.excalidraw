      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Agree the delivery split rule (e.g. equal per buyer).\nKeep full addresses and wallet details private.\nNo bulk discounts, supplier negotiation, resale\nor delivery to multiple homes in this MVP.",
